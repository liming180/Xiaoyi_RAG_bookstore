# 复制为 deploy/local-mysql.env（该文件被 .gitignore 的 deploy/local-mysql.env 忽略）。
# 本机模式不使用 Docker，也不需要 mysql:8.0 镜像。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=替换为本机MySQL密码

# 只有 deploy/docker-compose.yml（mysql 也在容器里）才需要下面两个。
# mysql 镜像拒绝 MYSQL_USER=root，容器里的业务账号用 MYSQL_USER_FOR_CONTAINER，
# 上面的 MYSQL_USER 只用于宿主机直连模式。
MYSQL_USER_FOR_CONTAINER=xiaoyi
MYSQL_ROOT_PASSWORD=替换为mysql容器的root密码

# 独立验收库：默认是 xiaoyi_rag_local_gate，不是开发库 xiaoyi_rag。
# 空库即可；Java 启动时 Flyway 自动执行 V1–V7，不要手工重复执行迁移。
MYSQL_DATABASE=xiaoyi_rag_local_gate

# 至少 32 UTF-8 字节；可用 openssl rand -base64 48 生成。
AUTH_JWT_SECRET=替换为至少32字节的随机密钥
AUTH_JWT_ISSUER=xiaoyi-rag
INTERNAL_TOKEN=替换为独立的内部调用随机令牌

# 首次启动创建两个真实 BCrypt 账号；密码 12–72 UTF-8 字节。
AUTH_BOOTSTRAP_USERNAME=local-a
AUTH_BOOTSTRAP_PASSWORD=替换为至少12字节的A账号密码
AUTH_SECONDARY_BOOTSTRAP_USERNAME=local-b
AUTH_SECONDARY_BOOTSTRAP_PASSWORD=替换为至少12字节的B账号密码

# 留空使用 test-artifacts/local-mysql/ 下的隔离目录。
STORAGE_ROOT=
AI_STORAGE_ROOT=

# false=Java→真实 Python；true=Java 内置 MockAiClient（J3/J5 验收用）。
AI_MOCK=false
# 入库阶段之间的节拍（毫秒）。0=全速；要给黑盒用例留出观测窗口就设 1200
# （Java 侧 1s 轮询一次，低于 1000 会漏掉中间阶段）。
INGEST_STAGE_DELAY_MS=1200

# ---- Python 侧的 provider（只被 server-ai 读取，Java 不读）----
# real：向量化与生成打真实服务；mock：完全离线，用确定性假向量 + 模板回答。
AI_PROVIDER=real
# OpenAI 兼容端点，程序会自己在后面拼 /embeddings 与 /chat/completions。
EMBEDDING_ENDPOINT=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_API_KEY=替换为向量化服务的APIKey
# 智谱 embedding-3 实测单批 8 条稳定；调大后遇到 413 会自动对半拆分重提。
EMBEDDING_BATCH_SIZE=8
LLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_API_KEY=替换为对话服务的APIKey
LLM_TIMEOUT_MS=60000

# ---- 向量库 ----
# 留空 = 进程内内存实现（单测与 mock 档用，重启即丢）。
# 容器栈里填 http://milvus:19530（两份 compose 共用 xiaoyi-net 网络）；
# 宿主机直跑 uvicorn 时填 http://127.0.0.1:19530。
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=xiaoyi_chunks
