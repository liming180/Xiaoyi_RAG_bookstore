{
  "name": "xiaoyi-rag-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json,md}\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "gen:api": "node scripts/gen-api-types.mjs",
    "gate": "node scripts/gate.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "smoke": "node scripts/smoke.mjs",
    "regress": "node scripts/regress.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.21.0",
    "element-plus": "2.14.7",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.10.2",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "2.1.9",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.7.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "15.15.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "2.2.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}