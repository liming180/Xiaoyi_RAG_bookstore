# ---- 依赖 ----
node_modules/
.pnpm-store/

# ---- 构建产物 ----
dist/
dist-ssr/
build/
target/
*.local

# ---- 测试与缓存 ----
coverage/
test-artifacts/
.snapshots/
.vitest/
.vite/
*.tsbuildinfo

# ---- 环境与密钥 ----
.env
.env.local
.env.*.local
config.local.json
# 本机 MySQL 模式的实际凭据（模板 deploy/local-mysql.env.example 进版本库）
deploy/local-mysql.env

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# ---- 日志与临时 ----
logs/
*.log
.workbuddy-ai/

# ---- 编辑器 / 系统 ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 运行期数据（可重新生成） ----
exports/
# 上传的资料落在 server-java/storage/{documentId}/ 下（xiaoyi.storage.root），是运行期数据。
# 第二条兜住「从仓库根起 java」时 ./storage 落到根上的情况——那是配置错位，不该进库。
server-java/storage/
/storage/
# pytest 跑 Python 侧时 STORAGE_ROOT 默认落到 test/storage/（含 ai-state.sqlite3）。
test/storage/

# ---- Milvus ----
# Milvus 的 user.yaml 含智谱 API key，只提交 user.yaml.example。
# 注意：目录搬迁后旧规则（deploy/milvus/）会失效，必须覆盖新路径，
# 否则 infra/milvus/user.yaml 会被误提交（本轮已踩过，key 暴露在待推提交里）。
deploy/milvus/user.yaml
infra/milvus/user.yaml

# ---- 一键启动生成的启动器 ----
# deploy/run/*.cmd 由 deploy/scripts/make_launchers.py 生成，
# 里面固化了 MySQL 密码、JWT secret、内部令牌和智谱 API key，不能进库。
# 启动后端时脚本会按需重新生成，无需提交。
deploy/run/

# ---- nginx 二进制（体积大、平台相关，按需下载） ----
# 只提交我们自己的 conf/nginx.conf；nginx 程序本体（nginx.exe、内置 conf、
# html 产物、logs、temp）不入库。新环境按 deploy/README-一键启动.md 下载解压即可。
deploy/nginx-windows/nginx-1.27.4/
deploy/nginx-windows/*.zip
# html 是前端构建产物，同样不入库
deploy/nginx-windows/html/
